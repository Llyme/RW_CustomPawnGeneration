<Project Sdk="Microsoft.NET.Sdk">
  <!--
    RimWorld 1.7 runs on .NET 10 (Waylith CLR), and Harmony for 1.7 targets net10.0,
    so this project must target net10.0 as well.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>RW_CustomPawnGeneration</RootNamespace>
    <AssemblyName>RW_CustomPawnGeneration</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <!-- Properties\AssemblyInfo.cs already defines the assembly attributes. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <RimWorldDir>C:\Program Files (x86)\Steam\steamapps\common\RimWorld</RimWorldDir>
    <HarmonyDir>C:\Program Files (x86)\Steam\steamapps\workshop\content\294100\2009463077\1.7\Assemblies</HarmonyDir>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>full</DebugType>
    <OutputPath>Build\v1.7-debug\Assemblies\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>Build\v1.7\Assemblies\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- Game and Harmony assemblies are provided at runtime; never copy them into the mod. -->
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldDir)\UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Build\**;obj\**" />
    <None Remove="Build\**;obj\**" />
    <Compile Update="Strings.g.cs">
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.cs</DependentUpon>
    </Compile>
  </ItemGroup>
  <!--
    Regenerate Strings.g.cs from Languages/English/Keyed/*.xml before every build.
    Requires the .NET SDK ('dotnet' on PATH). Non-fatal: if dotnet is missing the
    checked-in Strings.g.cs is used as-is. Set GenerateStrings=false to skip.
  -->
  <PropertyGroup>
    <GenerateStrings Condition=" '$(GenerateStrings)' == '' ">true</GenerateStrings>
  </PropertyGroup>
  <Target Name="GenerateStrings" BeforeTargets="BeforeBuild" Condition=" '$(GenerateStrings)' == 'true' ">
    <Exec Command="dotnet run --project &quot;$(ProjectDir)..\Tools\GenStrings\GenStrings.csproj&quot; --configuration Release --verbosity quiet" ContinueOnError="true" WorkingDirectory="$(ProjectDir)" />
  </Target>
</Project>
