{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build (Release)",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/Source/RW_CustomPawnGeneration.csproj",
                "-c",
                "Release"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "clear": true
            }
        },
        {
            "label": "Build (Debug)",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/Source/RW_CustomPawnGeneration.csproj",
                "-c",
                "Debug"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        }
    ]
}
